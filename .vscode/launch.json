{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/run_pipeline.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Load into MySQL",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/load_to_mysql.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
